{
  "expo": {
    "name": "FreightLedger",
    "slug": "freightledger",
    "version": "1.0.0",
    "scheme": "freightledger",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1565C0"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.freightledger.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1565C0"
      },
      "package": "com.freightledger.app",
      "softwareKeyboardLayoutMode": "resize",
      "navigationBar": {
        "backgroundColor": "#FFFFFF",
        "barStyle": "dark-content"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "FreightLedger needs photo access to upload POD documents.",
          "cameraPermission": "FreightLedger needs camera access to capture POD documents."
        }
      ],
      "expo-sharing",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
